{
  "name": "dsh-speech-to-text-gigaam",
  "version": "0.4.0",
  "description": "Local GigaAM (Sber) Russian speech recognition provider for DeepSeek Harness voice input",
  "type": "module",
  "exports": {
    ".": "./lib/index.js",
    "./package.json": "./package.json",
    "./locale/*.json": "./locale/*.json",
    "./icon": "./icon.svg"
  },
  "files": [
    "lib",
    "cordis.patch.yml",
    "python/gigaam_stt.py",
    "python/setup.sh",
    "python/requirements-macos-arm64.lock",
    "python/requirements-macos-arm64.in",
    "locale/*.json",
    "icon.svg",
    "README.md",
    "LICENSE"
  ],
  "scripts": {
    "test": "node --test test/worker.mjs test/download.mjs test/runtime.mjs && node test/preparation.mjs",
    "test:smoke": "node test/smoke.mjs",
    "test:python": "python3 -B -m unittest discover -s test -p python_worker.py -v",
    "setup:runtime": "node lib/setup-cli.js"
  },
  "dsh": {
    "bundle": {
      "patch": "./cordis.patch.yml"
    }
  },
  "keywords": [
    "deepseek-harness",
    "dsh",
    "dsh-plugin",
    "speech-to-text",
    "asr",
    "gigaam",
    "russian",
    "voice-input"
  ],
  "author": "Evgeny Klimov",
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/kelvmg/dsh-speech-to-text-gigaam.git"
  },
  "homepage": "https://github.com/kelvmg/dsh-speech-to-text-gigaam#readme",
  "bugs": {
    "url": "https://github.com/kelvmg/dsh-speech-to-text-gigaam/issues"
  },
  "engines": {
    "node": ">=20.3.0"
  },
  "dependencies": {
    "proper-lockfile": "4.1.2"
  }
}
